683-ba88aef3-0f68-4362-8837-2f67ebaaca30.jpg\",\"department\":\"Antioquia\",\"city\":\"Medellín\",\"zone\":\"Estadio\",\"whatsapp\":\"321 7752321\",\"verificationBadge\":null,\"badgeVerificationLevel\":null,\"promotedUntil\":null,\"dailyVideo\":null,\"profileSlug\":\"alessia-3217752321--cETjLrdFJubrQcVROhYw1fzAy5l2\",\"profilePath\":\"/escorts/medellin/alessia-3217752321--cETjLrdFJubrQcVROhYw1fzAy5l2\",\"privateMediaCount\":0,\"hasProfileVideo\":false},{\"id\":\"gCaE5o7HjkO4NRoKJtwctY6iYLp2\",\"name\":\"Eimy\",\"price\":200000,\"rating\":0,\"photoUrl\":\"https://pp-profile-photos-cdn.b-cdn.net/users/gCaE5o7HjkO4NRoKJtwctY6iYLp2/1781583570937-7774efd1-2d27-4430-8a6a-3af4f1a3773b.jpg\",\"department\":\"Antioquia\",\"city\":\"Medellín\",\"zone\":\"Estadio\",\"whatsapp\":\"3207636138\",\"verificationBadge\":null,\"badgeVerificationLevel\":null,\"promotedUntil\":null,\"dailyVideo\":null,\"profileSlug\":\"eimy-3207636138--gCaE5o7HjkO4NRoKJtwctY6iYLp2\",\"profilePath\":\"/escorts/medellin/eimy-3207636138--gCaE5o7HjkO4NRoKJtwctY6iYLp2\",\"privateMediaCount\":1,\"hasProfileVideo\":true},{\"id\":\"sSyF1hfBtVXBncwqWWChHdvr7ml2\",\"name\":\"Romina\",\"price\":300000,\"rating\":0,\"photoUrl\":\"https://pp-profile-photos-cdn.b-cdn.net/users/sSyF1hfBtVXBncwqWWChHdvr7ml2/1781580027543-58628386-140f-46d3-9548-f270371dc35e.jpg\",\"department\":\"Antioquia\",\"city\":\"Medellín\",\"zone\":\"Laureles\",\"whatsapp\":\"3128694874\",\"verificationBadge\":null,\"badgeVerificationLevel\":null,\"promotedUntil\":null,\"dailyVideo\":null,\"profileSlug\":\"romina-3128694874--sSyF1hfBtVXBncwqWWChHdvr7ml2\",\"profilePath\":\"/escorts/medellin/romina-3128694874--sSyF1hfBtVXBncwqWWChHdvr7ml2\",\"privateMediaCount\":0,\"hasProfileVideo\":false},{\"id\":\"z4GSTiPDMMXzTAUeCKfRVG9xFra2\",\"name\":\"Fiorella\",\"price\":200000,\"rating\":0,\"photoUrl\":\"https://pp-profile-photos-cdn.b-cdn.net/users/z4GSTiPDMMXzTAUeCKfRVG9xFra2/1781576228205-94248e46-3032-4599-8307-3f5e3926ddbb.jpg\",\"department\":\"Antioquia\",\"city\":\"Medellín\",\"zone\":\"Laureles\",\"whatsapp\":\"3013178836\",\"verificationBadge\":null,\"badgeVerificationLevel\":null,\"promotedUntil\":null,\"dailyVideo\":null,\"profileSlug\":\"fiorella-3013178836--z4GSTiPDMMXzTAUeCKfRVG9xFra2\",\"profilePath\":\"/escorts/medellin/fiorella-3013178836--z4GSTiPDMMXzTAUeCKfRVG9xFra2\",\"privateMediaCount\":0,\"hasProfileVideo\":false}],\"initialCity\":\"Medellín\",\"initialDepartment\":\"Antioquia\",\"pageTitle\":\"Escorts en Medellín\",\"pageEyebrow\":\"Escorts por ciudad\",\"pageDescription\":\"Perfiles aprobados en Medellín, Antioquia, para busquedas como escorts medellin, escorts en medellin, prepagos medellin y acompanantes medellin, con fotos publicas, zonas disponibles y contacto directo por WhatsApp en BelaClub.\",\"seoCityLinks\":[{\"href\":\"/prepagos/medellin\",\"label\":\"Prepagos en Medellín\"},{\"href\":\"/acompanantes/medellin\",\"label\":\"Acompañantes en Medellín\"},{\"href\":\"/damas-de-compania/medellin\",\"label\":\"Damas de compañía en Medellín\"},{\"href\":\"/chicas/medellin\",\"label\":\"Chicas en Medellín\"},{\"href\":\"/masajistas/medellin\",\"label\":\"Masajistas en Medellín\"},{\"href\":\"/universitarias/medellin\",\"label\":\"Universitarias en Medellín\"}],\"seoContent\":{\"heading\":\"Escorts en Medellín: perfiles, zonas y contexto local\",\"paragraphs\":[\"Medellín es una de las ciudades con mayor movimiento para encontrar perfiles por zonas como El Poblado, Laureles, Belén, Estadio, Centro y Ciudad del Río.\",\"Medellin tiene busquedas repartidas por sectores; El Poblado, Laureles, Belen, Estadio, Centro y Ciudad del Rio concentran buena parte de la exploracion.\",\"Para escorts en Medellin, el valor esta en diferenciar zonas y perfiles activos dentro de una ciudad con mucha oferta.\",\"Actualmente se muestran 46 perfiles activos en Medellín; el listado cambia cuando un perfil se aprueba, se pausa o actualiza su informacion.\",\"Zonas utiles para comparar: El Poblado, Laureles, Belén, Estadio, Centro y Ciudad del Río.\",\"Como el area metropolitana conecta con Envigado, Itagui y Sabaneta, los filtros por ciudad y zona ayudan a evitar revisar perfiles fuera del sector deseado.\",\"Tambien se conectan busquedas relacionadas como prepagos, acompañantes, damas de compañía, chicas, masajistas, universitarias y putas, manteniendo el foco principal en perfiles de Medellín.\",\"La pagina se alimenta de perfiles aprobados y visibles, con datos de ubicacion y galeria publica para que la comparacion sea mas clara desde movil.\"],\"searchTerms\":[\"Escorts en Medellín\",\"Escorts Medellín\",\"escorts en Medellín\",\"escorts Medellín\",\"escorts medellin\",\"escorts en medellin\",\"prepagos medellin\",\"acompanantes medellin\",\"prepagos en Medellín\",\"prepagos Medellín\",\"putas en Medellín\",\"putas Medellín\",\"acompanantes en Medellín\",\"damas de compania en Medellín\",\"chicas en Medellín\",\"masajistas en Medellín\",\"universitarias en Medellín\"],\"faqs\":[{\"question\":\"Donde encontrar escorts en Medellín?\",\"answer\":\"En BelaClub puedes revisar 46 perfiles visibles y aprobados en Medellín, Antioquia. La pagina prioriza perfiles activos, fotos publicas y contacto directo por WhatsApp.\"},{\"question\":\"Que zonas de Medellín se pueden revisar?\",\"answer\":\"Las busquedas se organizan alrededor de El Poblado, Laureles, Belén, Estadio y Centro. Tambien puedes revisar busquedas cercanas en Envigado, Itagui, Sabaneta y Rionegro.\"},{\"question\":\"La pagina de Escorts en Medellín se actualiza?\",\"answer\":\"Si. La pagina usa los perfiles activos, visibles y aprobados dentro de BelaClub, por eso el listado puede cambiar cuando se aprueban, pausan o actualizan perfiles.\"},{\"question\":\"Tambien sirve para buscar prepagos, acompañantes, damas de compañía, chicas, masajistas, universitarias y putas en Medellín?\",\"answer\":\"Si. BelaClub conecta busquedas relacionadas con paginas filtradas por ciudad para que el usuario pueda comparar categorias sin salir del contexto local.\"}],\"zones\":[\"El Poblado\",\"Laureles\",\"Belén\",\"Estadio\",\"Centro\",\"Ciudad del Río\"],\"relatedLinks\":[\"$14:props:seoCityLinks:0\",\"$14:props:seoCityLinks:1\",\"$14:props:seoCityLinks:2\",\"$14:props:seoCityLinks:3\",\"$14:props:seoCityLinks:4\",\"$14:props:seoCityLinks:5\",{\"href\":\"/putas/medellin\",\"label\":\"Putas en Medellín\"},{\"href\":\"/escorts/rionegro\",\"label\":\"Escorts en Rionegro\"},{\"href\":\"/escorts/la-ceja\",\"label\":\"Escorts en La Ceja\"},{\"href\":\"/escorts/bello\",\"label\":\"Escorts en Bello\"},{\"href\":\"/escorts/zipaquira\",\"label\":\"Escorts en Zipaquirá\"}]},\"showPageIntro\":false}]\n"])</script></body></html>